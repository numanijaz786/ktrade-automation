# Copy to apps/api/.env (never commit .env files — see docs/04).
# Values below are LOCAL DEVELOPMENT defaults only. Real secrets come from your OS keychain / secret manager.

# ── API ──────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ── Infrastructure (matches infra/docker-compose.yml defaults) ───
DATABASE_URL=postgresql://ktrade:ktrade_dev_only@localhost:5432/ktrade
REDIS_URL=redis://localhost:6379

# ── Added in later phases (names only; leave empty) ─────────────
# APP_MASTER_KEY=            # Phase 4: KEK for the credential vault (prefer OS keychain)
# JWT_PRIVATE_KEY_PEM=       # Phase 4: Ed25519 signing key
# JWT_PUBLIC_KEY_PEM=
# SMTP_URL=                  # Phase 10: email notifications (stored in vault when set via UI)
# TELEGRAM_BOT_TOKEN=        # Phase 10
# MARKET_DATA_PROVIDER=simulated   # Phase 7: simulated | csv-eod | capitalstake (needs licence)
# LLM_PROVIDER=              # Phase 11
