# Copy to apps/api/.env (never commit .env files — see docs/04).
# Values below are LOCAL DEVELOPMENT defaults only. Real secrets come from your OS keychain / secret manager.
# Comments are on their own lines on purpose: values are validated strictly at startup.

# ── API ──────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Hops allowed to set X-Forwarded-For (IPs, CIDRs or loopback|linklocal|uniquelocal; empty = none).
# Default loopback (the local BFF). Never use hop counts or 0.0.0.0/0: that makes client IPs spoofable.
TRUST_PROXY_ADDRESSES=loopback

# ── Infrastructure (matches infra/docker-compose.yml defaults) ───
DATABASE_URL=postgresql://ktrade:ktrade_dev_only@localhost:5432/ktrade
REDIS_URL=redis://localhost:6379

# ── Secrets: generate with `pnpm --filter @ktrade/api keys:generate` and paste here ──
# JWT_PRIVATE_KEY_B64=
# JWT_PUBLIC_KEY_B64=
# APP_MASTER_KEY=
# Local http only (browsers allow Secure cookies on localhost, but some tools do not):
# COOKIE_SECURE=false

# ── Background jobs (all off by default; on = runs inside the API process) ──
# Refresh quotes every 15 s:
MARKET_DATA_TICKER=false
# End-of-day portfolio snapshots after 16:00 PKT on trading days:
SNAPSHOT_SCHEDULER=false
# Evaluate alerts every 60 s during market hours:
ALERTS_SCHEDULER=false
# Evaluate active strategies once per completed bar after 15:35 PKT on trading days (LIVE: signals only, never orders):
STRATEGY_SCHEDULER=false

# ── Web app (apps/web/.env.local) ────────────────────────────────
# NEXT_PUBLIC_DATA_MODE=api
# API_BASE_URL=http://127.0.0.1:3001/api/v1
# BFF_COOKIE_SECURE=false
# Only behind nginx (which overwrites X-Real-IP): forward the client IP to the API. Keep false otherwise.
# BFF_TRUST_PROXY=false

# ── Later (configured through the app, never here in production) ─
# SMTP_URL=
# TELEGRAM_BOT_TOKEN=
# LLM_PROVIDER=
