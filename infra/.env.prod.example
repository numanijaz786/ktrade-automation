# Template for infra/.env.prod (gitignored). Secrets are NAMES ONLY: never put a real secret value in this
# file (only non-secret defaults are filled in).
#   cp infra/.env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
# Read by postgres, migrate and api (docker-compose.prod.yml). web and nginx get no secrets.
# One KEY=value per line, no quotes, no inline comments (values are validated strictly at startup).

# ── Database ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   (hex: safe inside a URL without escaping)
POSTGRES_PASSWORD=
# Must use the same password:  postgresql://ktrade:<POSTGRES_PASSWORD>@postgres:5432/ktrade
DATABASE_URL=

# ── API secrets: generate with
#    docker compose -f infra/docker-compose.prod.yml run --rm --no-deps api node scripts/generate-keys.mjs
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
APP_MASTER_KEY=

# ── API settings ─────────────────────────────────────────────────
# Public origin, e.g. https://trade.example.com (the browser never calls the API directly; kept tight anyway).
CORS_ORIGINS=
LOG_LEVEL=info

# ── Background jobs (true|false, all default false). Enable after the first successful login. ──
MARKET_DATA_TICKER=false
SNAPSHOT_SCHEDULER=false
ALERTS_SCHEDULER=false
STRATEGY_SCHEDULER=false

# ── Backups (infra/scripts/backup.sh) ────────────────────────────
# Optional age recipient (public key, age1...). When set, dumps are encrypted; keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=
# Days of backups to keep (default 14).
BACKUP_RETENTION_DAYS=14
